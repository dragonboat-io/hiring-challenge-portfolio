# Azure OpenAI — the assistant will not start a turn without these.
# Endpoint is the OpenAI-compatible "v1" surface, e.g.
#   https://<resource>.openai.azure.com/openai/v1
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# The deployment name, used as the model id (e.g. gpt-4.1, gpt-5.6-sol).
AZURE_OPENAI_DEPLOYMENT=
# Optional. Left at "none" because reasoning items 400 when replayed in a
# multi-step tool loop against Azure's Responses API.
AZURE_OPENAI_REASONING_EFFORT=none

# SQLite file. Defaults to ./data/app.db; docker-compose overrides it.
DATABASE_PATH=./data/app.db
